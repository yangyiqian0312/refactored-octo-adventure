PORT=3001
OVERLAY_ALLOWED_TOKEN=local-dev-overlay-token

TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_BASE_URL=https://auth.tiktok-shops.com
TIKTOK_API_VERSION=202309
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_ID=
TIKTOK_SHOP_CIPHER=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# Optional second shop on the same TikTok webhook/backend.
# Use this when TikTok Partner Center only allows one webhook URL.
TIKTOK_STORE2_OVERLAY_TOKEN=otaku-overlay-token
TIKTOK_STORE2_SHOP_ID=
TIKTOK_STORE2_SHOP_CIPHER=
TIKTOK_STORE2_ACCESS_TOKEN=
TIKTOK_STORE2_REFRESH_TOKEN=

# Optional third shop on the same TikTok webhook/backend.
TIKTOK_STORE3_OVERLAY_TOKEN=crossingtcg-overlay-token
TIKTOK_STORE3_SHOP_ID=
TIKTOK_STORE3_SHOP_CIPHER=
TIKTOK_STORE3_ACCESS_TOKEN=
TIKTOK_STORE3_REFRESH_TOKEN=

# Optional override. By default webhook verification uses TIKTOK_APP_SECRET.
TIKTOK_WEBHOOK_SECRET=
TIKTOK_WEBHOOK_VERIFY_BYPASS=true

# Local Rollo label printing. The cloud server emits label:print only for this shop id.
LABEL_PRINT_SHOP_ID=7495210574874380572
LABEL_PRINT_WAREHOUSE_ID=7581531451641317175
LABEL_PRINT_SHOP_ID_2=7495169240868424019
LABEL_PRINT_WAREHOUSE_ID_2=7499833317727225642
LABEL_PRINT_SHOP_ID_3=7495210574874380572
LABEL_PRINT_WAREHOUSE_ID_3=7499485115637696302
PRINT_AGENT_SERVER_URL=https://tiktok-shop-live-alert-server.onrender.com
PRINT_AGENT_TOKEN=crossingtcg-overlay-token
PRINT_AGENT_DRY_RUN=true
PRINT_AGENT_UI_PORT=3002
# Optional initial warehouse; otherwise choose in the local print console.
PRINT_AGENT_WAREHOUSE_ID=

# Each shop has its own connection token. Never reuse PRINT_AGENT_TOKEN for both.
# These IDs must match the actual shop associated with the corresponding token.
PRINT_AGENT_OTAKU_SHOP_ID=
PRINT_AGENT_OTAKU_WAREHOUSE_IDS=7499833317727225642
PRINT_AGENT_CROSSING_SHOP_ID=
PRINT_AGENT_CROSSING_WAREHOUSE_IDS=7581531451641317175,7499485115637696302
# Optional token overrides; otherwise use TIKTOK_STORE2/3_OVERLAY_TOKEN above.
PRINT_AGENT_OTAKU_TOKEN=
PRINT_AGENT_CROSSING_TOKEN=
# Optional separate backend URLs; otherwise use PRINT_AGENT_SERVER_URL.
PRINT_AGENT_OTAKU_SERVER_URL=
PRINT_AGENT_CROSSING_SERVER_URL=
# Optional initial shop: otaku or crossing. The saved UI selection takes precedence.
PRINT_AGENT_PROFILE_ID=
